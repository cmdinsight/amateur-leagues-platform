// Prisma schema for the amateur sports leagues platform.
// Multi-tenant: each League is a client (their own branding, teams, divisions).
// Players and Teams are global to the League (not tied to a single tournament),
// so career stats can follow them across divisions and tournaments.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// A lead from the platform's own marketing homepage: someone who wants
// CMD Tech to set them up with a new league on the platform. Not tied to
// any League — it comes in before one exists.
model ContactRequest {
  id         String   @id @default(cuid())
  fullName   String
  leagueName String
  city       String?
  contact    String
  message    String?
  createdAt  DateTime @default(now())
}

model League {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  sport         String   @default("futbol7")
  city          String?
  logoUrl       String?
  primaryColor  String   @default("#16a34a")
  accentColor   String   @default("#0f172a")
  adminPassword String   @default("demo1234")
  createdAt     DateTime @default(now())

  divisions   Division[]
  teams       Team[]
  sponsors    Sponsor[]
  photos      Photo[]
  newsPosts   NewsPost[]
  freeAgents  FreeAgentListing[]
}

model Sponsor {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name      String
  logoUrl   String
  linkUrl   String?
  createdAt DateTime @default(now())
}

model Photo {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now())
}

model NewsPost {
  id          String   @id @default(cuid())
  leagueId    String
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  title       String
  body        String
  publishedAt DateTime @default(now())
}

enum FreeAgentType {
  JUGADOR_LIBRE
  BUSCO_EQUIPO
}

// Self-serve board: players looking for a team, or teams recruiting players.
// A lightweight stand-in for full player accounts/auth (see README).
model FreeAgentListing {
  id        String        @id @default(cuid())
  leagueId  String
  league    League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  type      FreeAgentType
  fullName  String
  position  String?
  contact   String
  message   String?
  createdAt DateTime      @default(now())
}

// A division groups teams by competitive level (e.g. "Primera División",
// "Segunda División"). A division can run several tournaments over time.
model Division {
  id        String   @id @default(cuid())
  name      String
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  tournaments Tournament[]

  @@unique([leagueId, name])
}

enum TournamentFormat {
  LIGA // single round-robin table
  GRUPOS // group stage (optionally followed by knockout matches tagged with `stage`)
  ELIMINACION // single-elimination bracket
}

// A concrete competition within a division (e.g. "Apertura 2026"), with its
// own format and its own set of entered teams, groups and matches.
model Tournament {
  id         String           @id @default(cuid())
  name       String
  divisionId String
  division   Division         @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  format     TournamentFormat @default(LIGA)
  maxTeams   Int?
  isActive   Boolean          @default(true)
  startDate  DateTime         @default(now())
  endDate    DateTime?

  groups  Group[]
  entries TeamTournament[]
  matches Match[]

  @@unique([divisionId, name])
}

// Only used when a tournament's format is GRUPOS.
model Group {
  id           String     @id @default(cuid())
  name         String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  isFinished   Boolean    @default(false)

  entries TeamTournament[]
  matches Match[]

  @@unique([tournamentId, name])
}

model Team {
  id        String  @id @default(cuid())
  name      String
  shortName String?
  crestUrl  String?
  leagueId  String
  league    League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  rosterSpots RosterSpot[]
  entries     TeamTournament[]
  homeMatches Match[]          @relation("HomeTeam")
  awayMatches Match[]          @relation("AwayTeam")
  matchEvents MatchEvent[]
  appearances MatchAppearance[]

  @@unique([leagueId, name])
}

// A team's entry into a specific tournament (and, for GRUPOS tournaments,
// which group it was placed in).
model TeamTournament {
  id           String     @id @default(cuid())
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([teamId, tournamentId])
}

// A Player is global to the platform, so their history can span multiple
// teams, divisions, tournaments and even leagues over time.
model Player {
  id        String    @id @default(cuid())
  fullName  String
  photoUrl  String?
  birthDate DateTime?
  createdAt DateTime  @default(now())

  rosterSpots RosterSpot[]
  matchEvents MatchEvent[]
  appearances MatchAppearance[]
}

// A player's current team membership (their shirt number etc). A player can
// move to a different team at any time — past stats stay attributed to
// whichever team they scored for (see MatchEvent.teamId).
model RosterSpot {
  id       String  @id @default(cuid())
  number   Int?
  position String?
  playerId String
  teamId   String
  player   Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([playerId, teamId])
}

enum MatchStatus {
  SCHEDULED
  PLAYED
  POSTPONED
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  stage        String? // e.g. "Fase de grupos", "Cuartos de final", "Semifinal", "Final"
  round        Int? // "Fecha N" — matchday number within the tournament/group
  matchDate    DateTime
  venue        String? // cancha
  status       MatchStatus @default(SCHEDULED)
  homeTeamId   String
  awayTeamId   String
  homeTeam     Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int?
  awayScore    Int?

  events      MatchEvent[]
  appearances MatchAppearance[]
}

enum MatchEventType {
  GOAL
  YELLOW_CARD
  RED_CARD
}

model MatchEvent {
  id       String         @id @default(cuid())
  matchId  String
  match    Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type     MatchEventType
  minute   Int?
}

// Which players from each team's registered roster actually played a
// specific match (the "convocatoria"), set by the match's veedor when
// closing it — before goals/cards are attributed. Also records which one
// of them played as goalkeeper for that match, making the imbatibles
// ranking and "partidos jugados" counts exact rather than approximated.
model MatchAppearance {
  id           String  @id @default(cuid())
  matchId      String
  match        Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isGoalkeeper Boolean @default(false)

  @@unique([matchId, playerId])
}
